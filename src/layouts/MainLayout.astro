---
import '../styles/global.css';
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-neutral-95 text-gray-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="../iconoApp.jpg" />
    <meta property="og:image" content="https://tu-proyecto.vercel.app/logo.png" />
    <title>{title} | MMA Pulse</title>
  </head>
  <body class="min-h-screen flex flex-col bg-neutral-900 text-neutral-100">
    <!-- Header -->
    <header class="border-b border-neutral-800 bg-neutral-950/80 backdrop-blur sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-black tracking-wider text-red-600 uppercase">
          MMA<span class="text-white">Pulse</span>
        </a>
        <nav class="space-x-6 text-sm font-semibold">
          <a href="/" class="hover:text-red-500 transition">Inicio</a>
          <a href="/noticias" class="hover:text-red-500 transition">Noticias</a>
        </nav>
      </div>
    </header>

    <!-- Contenido principal -->
    <main class="grow max-w-6xl w-full mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-neutral-800 bg-neutral-950 py-6 text-center text-sm text-neutral-500">
      <p>&copy; {new Date().getFullYear()} MMA Pulse - Fermin Blanco Ramirez</p>
    </footer>
  </body>
</html>