---
import "../styles/global.css";
interface Props {
  title: string;
}
import Analytics from "@vercel/analytics/astro";
const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-neutral-95 text-gray-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="../iconoApp.jpg" />
    <meta
      property="og:image"
      content="https://tu-proyecto.vercel.app/logo.png"
    />
    <title>{title} | UFC ADICTOS</title>
  </head>
  <body class="min-h-screen flex flex-col bg-neutral-900 text-neutral-100">
    <!-- Header -->
    <header class="border-b border-neutral-800 bg-neutral-900/80 backdrop-blur-md sticky top-0 z-50">
  <!-- Contenedor responsive: Columna en móvil, Fila en pantallas sm/md -->
  <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
    
    <!-- Logo de la app -->
    <a href="/" class="text-2xl font-black tracking-tight uppercase">
      <span class="text-red-600">MMA</span>PULSE
    </a>

    <!-- Menú de navegación responsive -->
    <nav class="flex items-center gap-4 sm:gap-6 text-xs sm:text-sm font-bold uppercase tracking-wider">
      <a href="/" class="hover:text-red-500 transition whitespace-nowrap">
        Última Hora
      </a>
      <a href="/noticias" class="hover:text-red-500 transition whitespace-nowrap">
        Todas las Noticias
      </a>
    </nav>

  </div>
</header>

    <!-- Contenido principal -->
    <main class="grow max-w-6xl w-full mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer
      class="border-t border-neutral-800 bg-neutral-950 py-6 text-center text-sm text-neutral-500"
    >
      <p>&copy; {new Date().getFullYear()} UFC ADICTOS - Fermin Blanco Ramirez</p>
    </footer>
  </body>
</html>
